(define info
  (cons "knights-of-the-situation-calculus:\n"
        "https://discord.gg/aPRZfafAns"))

(define join-lines (network [items text]
  (let-cell [title url]
    (p:car title items)
    (p:cdr url items)
    (-> (str title url) text)
    (list text))))

(define print-lines (network [items block]
  (let-cell [text]
    (join-lines items text)
    (block-at (instance printer) block text))))
