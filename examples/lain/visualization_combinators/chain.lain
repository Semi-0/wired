;; Every intermediate is data; only xr:io performs publication.
(def-cells input output relationships chain-graph selection)
(def-net chain [x] [out]
  (-> (tracked+ (tracked+ x 1) 1) out))
(chain input output)
(-> 5 input)

(def selected (occurrence-of chain input output))
(relationship:roots input output relationships)
(relationship:dataflow relationships chain-graph)
(def boundary? (:: [item]
  (tracked-or (member? item (inputs-of selected))
              (member? item (outputs-of selected)))))
(def boundary (filter boundary? chain-graph))
(def boundary-list (transpose boundary :list))
(def values (map (:: [item] (strongest-of item))
                 boundary-list))
(def focused (focus values selection))
(def sources (sources-of focused))
(def zoom (map (:: [ref] (strongest-of ref))
               sources))

;; The composition can itself be observed with the same graph tooling.
(def-cells composition-relationships composition-graph)
(relationship:roots values zoom composition-relationships)
(relationship:dataflow composition-relationships composition-graph)

;; Publish each intermediate collection and the composition's own topology.
;; Selecting a value drives focused, sources, and zoom without changing sources.
(xr:io (juxtapose chain-graph
                  boundary
                  boundary-list
                  (selectable values selection)
                  focused
                  sources
                  zoom
                  composition-graph))
