(define input)
(define output)
(define relationships)
(define chain-graph)
(define selection)
(define chain (network [x out] (-> (tracked+ (tracked+ x 1) 1) out) (list out)))
(chain input output)
(-> 5 input)
(define selected (occurrence-of chain input output))
(relationship:roots input output relationships)
(relationship:dataflow relationships chain-graph)
(define boundary? (network [item] (tracked-or (member? item (inputs-of selected)) (member? item (outputs-of selected)))))
(define boundary (filter boundary? chain-graph))
(define boundary-list (transpose boundary :list))
(define values (map (network [item] (strongest-of item)) boundary-list))
(define focused (focus values selection))
(define sources (sources-of focused))
(define zoom (map (network [ref] (strongest-of ref)) sources))
(define composition-relationships)
(define composition-graph)
(relationship:roots values zoom composition-relationships)
(relationship:dataflow composition-relationships composition-graph)
(xr:io (juxtapose chain-graph boundary boundary-list (selectable values selection) focused sources zoom composition-graph))